{
  "name": "ocr-ext",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.ts",
    "check": "tsc --noEmit && vitest run && vite build"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "*",
    "@tesseract.js-data/rus": "*",
    "@tesseract.js-data/ukr": "*",
    "onnxruntime-web": "1.20.1",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
